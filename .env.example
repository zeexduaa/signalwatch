# Copy this file to .env (which is git-ignored) or set these in your shell.
# signalwatch reads them from the environment; they never go in the watchlist file.

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
SIGNALWATCH_DISCORD_WEBHOOK=

# Telegram: create a bot with @BotFather, then message it and look up your chat id
SIGNALWATCH_TELEGRAM_TOKEN=
SIGNALWATCH_TELEGRAM_CHAT_ID=
